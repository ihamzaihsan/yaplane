# Reference values only: set these in your shell; no dotenv library is used.
FORUM_ADDR=:8080
DATABASE_PATH=data/forum.db
HOST_PORT=8080
TLS_CERT_FILE=.local/server.crt
TLS_KEY_FILE=.local/server.key

# Register Google and GitHub OAuth apps with these exact callback URLs:
# https://localhost:8080/auth/google/callback
# https://localhost:8080/auth/github/callback
# Leave credentials empty to keep that provider disabled.
OAUTH_BASE_URL=https://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Preserve immediate publication by default; true reviews members' new posts/comments.
FORUM_PREMODERATE=false
